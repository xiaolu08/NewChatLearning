{
  "general": {
    "description": "基础设置",
    "type": "object",
    "hint": "当前 Beta 已具备受控群聊采集与相邻问答固化能力；自动回复尚未开放。",
    "obvious_hint": true,
    "items": {
      "enabled": {
        "description": "启用插件",
        "type": "bool",
        "default": true
      },
      "legacy_command_aliases": {
        "description": "启用原版命令别名",
        "type": "bool",
        "default": true
      }
    }
  },
  "permissions": {
    "description": "权限设置",
    "type": "object",
    "hint": "AstrBot 全局管理员始终拥有插件管理权限。普通成员触发插件命令时不会收到回复。",
    "items": {
      "plugin_admin_ids": {
        "description": "插件管理员 QQ 号",
        "type": "list",
        "items": {"type": "string"},
        "default": []
      }
    }
  },
  "learning": {
    "description": "学习设置",
    "type": "object",
    "hint": "学习默认关闭。启用后仍只采集明确列出的 QQ 群；当前阶段不会自动回复。",
    "obvious_hint": true,
    "items": {
      "enabled": {
        "description": "启用群聊学习",
        "type": "bool",
        "default": false
      },
      "group_ids": {
        "description": "学习群号",
        "type": "list",
        "items": {"type": "string"},
        "hint": "每项填写一个 QQ 群号。留空时不学习任何群。",
        "default": []
      },
      "interval_seconds": {
        "description": "问答链最大间隔（秒）",
        "type": "int",
        "hint": "相邻两条合格消息超过此间隔时切断问答关系，默认保持原版 900 秒。",
        "default": 900
      }
    }
  },
  "storage": {
    "description": "本地存储",
    "type": "object",
    "items": {
      "media_quota_gb": {
        "description": "媒体空间上限（GB）",
        "type": "float",
        "hint": "达到上限后停止保存新媒体，但继续文本学习，不自动删除有效旧媒体。",
        "default": 10.0
      }
    }
  },
  "webui": {
    "description": "管理页面",
    "type": "object",
    "hint": "管理页面使用 AstrBot Dashboard 的登录态和插件页面安全通道。独立登录服务将在完整 WebUI 阶段实现。",
    "items": {
      "enabled": {
        "description": "启用管理页面",
        "type": "bool",
        "default": true
      }
    }
  },
  "tts": {
    "description": "语音回复",
    "type": "object",
    "hint": "云端 TTS 可能产生费用，默认关闭；核心学习和回复算法不会调用 LLM。",
    "items": {
      "enabled": {
        "description": "启用 TTS",
        "type": "bool",
        "default": false
      },
      "driver": {
        "description": "TTS 驱动",
        "type": "string",
        "options": ["windows", "gpt_sovits", "local_http", "volcengine", "aliyun", "tencent", "azure", "openai", "openai_compatible", "custom_http"],
        "default": "windows"
      }
    }
  }
}
