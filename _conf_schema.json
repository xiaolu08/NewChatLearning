{
  "general": {
    "description": "基础设置",
    "type": "object",
    "hint": "当前 Beta 已具备受控群聊采集、相邻问答固化与本地三级匹配回复能力。",
    "obvious_hint": true,
    "items": {
      "enabled": {
        "description": "启用插件",
        "type": "bool",
        "default": true
      },
      "legacy_command_aliases": {
        "description": "启用原版命令别名",
        "type": "bool",
        "default": true
      }
    }
  },
  "permissions": {
    "description": "权限设置",
    "type": "object",
    "hint": "AstrBot 全局管理员始终拥有插件管理权限。普通成员触发插件命令时不会收到回复。",
    "items": {
      "plugin_admin_ids": {
        "description": "插件管理员 QQ 号",
        "type": "list",
        "items": {"type": "string"},
        "default": []
      },
      "group_sub_admins": {
        "description": "群聊子管理员",
        "type": "template_list",
        "hint": "子管理员只在指定群拥有 NewChatLearning 管理权限。",
        "templates": {
          "group_sub_admins": {
            "name": "群聊子管理员",
            "display_item": "group_id",
            "hide_hint_in_list": true,
            "items": {
              "group_id": {
                "description": "群号",
                "type": "string",
                "default": ""
              },
              "admin_ids": {
                "description": "管理员 QQ 号",
                "type": "list",
                "items": {"type": "string"},
                "default": []
              }
            }
          }
        },
        "default": []
      }
    }
  },
  "learning": {
    "description": "学习设置",
    "type": "object",
    "hint": "学习默认关闭。启用后仍只采集明确列出的 QQ 群；学习与回复开关互相独立。",
    "obvious_hint": true,
    "items": {
      "enabled": {
        "description": "启用群聊学习",
        "type": "bool",
        "default": false
      },
      "group_ids": {
        "description": "学习群号",
        "type": "list",
        "items": {"type": "string"},
        "hint": "每项填写一个 QQ 群号。留空时不学习任何群。",
        "default": []
      },
      "target_users": {
        "description": "定向学习用户",
        "type": "template_list",
        "hint": "配置后，该群只有这些用户紧随其他群消息发言时才会固化为答案；其他消息仍可作为下一条问题。",
        "templates": {
          "target_users": {
            "name": "群聊定向用户",
            "display_item": "group_id",
            "hide_hint_in_list": true,
            "items": {
              "group_id": {"description": "群号", "type": "string", "default": ""},
              "user_ids": {
                "description": "目标用户 QQ 号",
                "type": "list",
                "items": {"type": "string"},
                "default": []
              }
            }
          }
        },
        "default": []
      },
      "interval_seconds": {
        "description": "问答链最大间隔（秒）",
        "type": "int",
        "hint": "相邻两条合格消息超过此间隔时切断问答关系，默认保持原版 900 秒。",
        "default": 900
      }
    }
  },
  "reply": {
    "description": "回复设置",
    "type": "object",
    "hint": "本地词库回复默认关闭。按精确、正则、jieba 词频余弦的顺序检索，不调用 LLM。",
    "obvious_hint": true,
    "items": {
      "enabled": {
        "description": "启用本地词库回复",
        "type": "bool",
        "default": false
      },
      "group_ids": {
        "description": "回复群号",
        "type": "list",
        "items": {"type": "string"},
        "hint": "只有明确列出的群可以自动回复。",
        "default": []
      },
      "silent_group_ids": {
        "description": "静默学习群号",
        "type": "list",
        "items": {"type": "string"},
        "hint": "这些群可以继续学习，但永远不会自动触发词库回复。",
        "default": []
      },
      "probability_percent": {
        "description": "回复概率（%）",
        "type": "float",
        "default": 50.0
      },
      "cooldown_seconds": {
        "description": "单群回复冷却（秒）",
        "type": "float",
        "default": 3.0
      },
      "wait_seconds": {
        "description": "回复等待基准（秒）",
        "type": "float",
        "default": 0.0
      },
      "wait_jitter_seconds": {
        "description": "回复等待浮动（秒）",
        "type": "float",
        "default": 0.0
      },
      "max_plain_length": {
        "description": "单条文本最大长度",
        "type": "int",
        "default": 100
      },
      "at_force_reply": {
        "description": "被 @ 时跳过概率判定",
        "type": "bool",
        "default": true
      },
      "regex_enabled": {
        "description": "启用正则问题匹配",
        "type": "bool",
        "default": true
      },
      "regex_timeout_ms": {
        "description": "单条正则超时（毫秒）",
        "type": "int",
        "hint": "用于限制异常或高复杂度表达式的执行时间。",
        "default": 50
      },
      "similarity_enabled": {
        "description": "启用 jieba 余弦相似度匹配",
        "type": "bool",
        "hint": "会增加本机 CPU 消耗，但不会调用模型或产生 Token。",
        "default": false
      },
      "similarity_threshold": {
        "description": "余弦相似度阈值",
        "type": "float",
        "default": 0.5
      },
      "similarity_max_length": {
        "description": "参与相似度匹配的文本最大长度",
        "type": "int",
        "default": 35
      },
      "type_frequency_thresholds": {
        "description": "消息类型发送频次阈值",
        "type": "object",
        "hint": "某类型组件仅在答案权重，或该答案内容作为问题出现的频次达到阈值时允许发送；0 表示不限制。",
        "items": {
          "Plain": {"description": "文本", "type": "int", "default": 0},
          "Image": {"description": "图片", "type": "int", "default": 0},
          "Face": {"description": "表情", "type": "int", "default": 0},
          "Record": {"description": "语音", "type": "int", "default": 0},
          "Video": {"description": "视频", "type": "int", "default": 0},
          "Json": {"description": "JSON 卡片", "type": "int", "default": 0},
          "File": {"description": "文件", "type": "int", "default": 0}
        }
      }
    }
  },
  "filters": {
    "description": "内容过滤与黑名单",
    "type": "object",
    "hint": "普通规则只在回复前生效，不改写已学习内容。敏感关键词会累计发送者命中次数，达到阈值后停止学习该用户。",
    "obvious_hint": true,
    "items": {
      "enabled": {"description": "启用过滤与黑名单", "type": "bool", "default": true},
      "contains": {"description": "包含关键词", "type": "list", "items": {"type": "string"}, "default": []},
      "exact": {"description": "完全匹配文本", "type": "list", "items": {"type": "string"}, "default": []},
      "regex": {"description": "回复过滤正则", "type": "list", "items": {"type": "string"}, "default": []},
      "component_types": {
        "description": "屏蔽的消息组件类型",
        "type": "list",
        "items": {"type": "string"},
        "hint": "默认保持原版规则，屏蔽 At、AtAll、Quote 和 Poke。",
        "default": ["At", "AtAll", "Quote", "Poke"]
      },
      "sensitive": {"description": "敏感关键词", "type": "list", "items": {"type": "string"}, "default": []},
      "blacklist_threshold": {"description": "自动拉黑命中阈值", "type": "int", "default": 5},
      "blacklist_scope": {"description": "黑名单范围", "type": "string", "options": ["global", "group"], "default": "global"},
      "regex_timeout_ms": {"description": "单条过滤正则超时（毫秒）", "type": "int", "default": 50},
      "group_rules": {
        "description": "群聊附加规则",
        "type": "template_list",
        "hint": "群聊规则与全局规则叠加，不会覆盖全局规则。",
        "templates": {
          "group_rules": {
            "name": "群聊附加过滤规则",
            "display_item": "group_id",
            "hide_hint_in_list": true,
            "items": {
              "group_id": {"description": "群号", "type": "string", "default": ""},
              "contains": {"description": "包含关键词", "type": "list", "items": {"type": "string"}, "default": []},
              "exact": {"description": "完全匹配文本", "type": "list", "items": {"type": "string"}, "default": []},
              "regex": {"description": "正则表达式", "type": "list", "items": {"type": "string"}, "default": []},
              "component_types": {"description": "组件类型", "type": "list", "items": {"type": "string"}, "default": []},
              "sensitive": {"description": "敏感关键词", "type": "list", "items": {"type": "string"}, "default": []}
            }
          }
        },
        "default": []
      }
    }
  },
  "storage": {
    "description": "本地存储",
    "type": "object",
    "items": {
      "media_persistence_enabled": {
        "description": "保存新媒体到本地",
        "type": "bool",
        "hint": "学习图片、语音、视频和文件时保存内容哈希副本，避免临时 URL 过期。",
        "default": true
      },
      "media_quota_gb": {
        "description": "媒体空间上限（GB）",
        "type": "float",
        "hint": "达到上限后停止保存新媒体，但继续文本学习，不自动删除有效旧媒体。",
        "default": 10.0
      },
      "media_max_file_mb": {
        "description": "单个媒体文件上限（MB）",
        "type": "float",
        "default": 50.0
      },
      "media_download_timeout_seconds": {
        "description": "媒体下载超时（秒）",
        "type": "float",
        "default": 15.0
      }
    }
  },
  "library": {
    "description": "词库范围",
    "type": "object",
    "hint": "普通模式只查询本群；全局模式实时联合查询，不复制词库文件。配置标签的群只查询共享标签范围。",
    "items": {
      "mode": {
        "description": "回复词库模式",
        "type": "string",
        "options": ["group", "global"],
        "default": "group"
      },
      "excluded_group_ids": {
        "description": "不进入全局词库的群号",
        "type": "list",
        "items": {"type": "string"},
        "hint": "仅影响未配置标签群使用的全局词库；不停止该群自身学习。",
        "default": []
      },
      "group_tags": {
        "description": "群聊共享标签",
        "type": "template_list",
        "hint": "添加群聊并填写标签名称列表。共享任一标签的群会进入同一个实时词库范围。",
        "templates": {
          "group_tags": {
            "name": "群聊标签",
            "display_item": "group_id",
            "hide_hint_in_list": true,
            "items": {
              "group_id": {
                "description": "群号",
                "type": "string",
                "default": ""
              },
              "tags": {
                "description": "标签名称",
                "type": "list",
                "items": {"type": "string"},
                "default": []
              }
            }
          }
        },
        "default": []
      }
    }
  },
  "webui": {
    "description": "管理页面",
    "type": "object",
    "hint": "管理页面使用独立密码和服务端会话。首次设置密码只能从运行 AstrBot 的本机访问；页面仍由 AstrBot Dashboard 承载。",
    "items": {
      "enabled": {
        "description": "启用管理页面",
        "type": "bool",
        "default": true
      }
    }
  },
  "tts": {
    "description": "语音回复",
    "type": "object",
    "hint": "云端 TTS 可能产生费用，默认关闭；核心学习和回复算法不会调用 LLM。",
    "items": {
      "enabled": {
        "description": "启用 TTS",
        "type": "bool",
        "default": false
      },
      "driver": {
        "description": "TTS 驱动",
        "type": "string",
        "options": ["windows", "gpt_sovits", "local_http"],
        "default": "windows"
      },
      "probability_percent": {
        "description": "语音回复概率（%）",
        "type": "float",
        "hint": "仅对纯文本词库答案生效；合成失败时自动回退文本。",
        "default": 0.0
      },
      "max_text_length": {
        "description": "最大合成文本长度",
        "type": "int",
        "default": 100
      },
      "voice": {
        "description": "音色或声音名称",
        "type": "string",
        "default": ""
      },
      "rate": {
        "description": "Windows 语速（-10 至 10）",
        "type": "int",
        "default": 0
      },
      "volume": {
        "description": "Windows 音量（0 至 100）",
        "type": "int",
        "default": 100
      },
      "endpoint_url": {
        "description": "本地 TTS 地址",
        "type": "string",
        "hint": "只接受带端口的 127.0.0.1、::1 或 localhost 地址。",
        "default": "http://127.0.0.1:9880/tts"
      },
      "timeout_seconds": {
        "description": "合成超时（秒）",
        "type": "float",
        "default": 30.0
      },
      "text_lang": {
        "description": "GPT-SoVITS 文本语言",
        "type": "string",
        "default": "zh"
      },
      "reference_audio_path": {
        "description": "GPT-SoVITS 参考音频路径",
        "type": "string",
        "default": ""
      },
      "prompt_text": {
        "description": "GPT-SoVITS 参考文本",
        "type": "string",
        "default": ""
      },
      "prompt_lang": {
        "description": "GPT-SoVITS 参考语言",
        "type": "string",
        "default": "zh"
      }
    }
  }
}
