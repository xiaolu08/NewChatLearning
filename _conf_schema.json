{
  "general": {
    "description": "基础设置",
    "type": "object",
    "hint": "当前 Beta 已具备受控群聊采集、相邻问答固化与本地三级匹配回复能力。",
    "obvious_hint": true,
    "items": {
      "enabled": {
        "description": "启用插件",
        "type": "bool",
        "default": true
      },
      "legacy_command_aliases": {
        "description": "启用原版命令别名",
        "type": "bool",
        "default": true
      }
    }
  },
  "permissions": {
    "description": "权限设置",
    "type": "object",
    "hint": "AstrBot 全局管理员始终拥有插件管理权限。普通成员触发插件命令时不会收到回复。",
    "items": {
      "plugin_admin_ids": {
        "description": "插件管理员 QQ 号",
        "type": "list",
        "items": {"type": "string"},
        "default": []
      }
    }
  },
  "learning": {
    "description": "学习设置",
    "type": "object",
    "hint": "学习默认关闭。启用后仍只采集明确列出的 QQ 群；学习与回复开关互相独立。",
    "obvious_hint": true,
    "items": {
      "enabled": {
        "description": "启用群聊学习",
        "type": "bool",
        "default": false
      },
      "group_ids": {
        "description": "学习群号",
        "type": "list",
        "items": {"type": "string"},
        "hint": "每项填写一个 QQ 群号。留空时不学习任何群。",
        "default": []
      },
      "interval_seconds": {
        "description": "问答链最大间隔（秒）",
        "type": "int",
        "hint": "相邻两条合格消息超过此间隔时切断问答关系，默认保持原版 900 秒。",
        "default": 900
      }
    }
  },
  "reply": {
    "description": "回复设置",
    "type": "object",
    "hint": "本地词库回复默认关闭。按精确、正则、jieba 词频余弦的顺序检索，不调用 LLM。",
    "obvious_hint": true,
    "items": {
      "enabled": {
        "description": "启用本地词库回复",
        "type": "bool",
        "default": false
      },
      "group_ids": {
        "description": "回复群号",
        "type": "list",
        "items": {"type": "string"},
        "hint": "只有明确列出的群可以自动回复。",
        "default": []
      },
      "silent_group_ids": {
        "description": "静默学习群号",
        "type": "list",
        "items": {"type": "string"},
        "hint": "这些群可以继续学习，但永远不会自动触发词库回复。",
        "default": []
      },
      "probability_percent": {
        "description": "回复概率（%）",
        "type": "float",
        "default": 50.0
      },
      "cooldown_seconds": {
        "description": "单群回复冷却（秒）",
        "type": "float",
        "default": 3.0
      },
      "wait_seconds": {
        "description": "回复等待基准（秒）",
        "type": "float",
        "default": 0.0
      },
      "wait_jitter_seconds": {
        "description": "回复等待浮动（秒）",
        "type": "float",
        "default": 0.0
      },
      "max_plain_length": {
        "description": "单条文本最大长度",
        "type": "int",
        "default": 100
      },
      "at_force_reply": {
        "description": "被 @ 时跳过概率判定",
        "type": "bool",
        "default": true
      },
      "regex_enabled": {
        "description": "启用正则问题匹配",
        "type": "bool",
        "default": true
      },
      "regex_timeout_ms": {
        "description": "单条正则超时（毫秒）",
        "type": "int",
        "hint": "用于限制异常或高复杂度表达式的执行时间。",
        "default": 50
      },
      "similarity_enabled": {
        "description": "启用 jieba 余弦相似度匹配",
        "type": "bool",
        "hint": "会增加本机 CPU 消耗，但不会调用模型或产生 Token。",
        "default": false
      },
      "similarity_threshold": {
        "description": "余弦相似度阈值",
        "type": "float",
        "default": 0.5
      },
      "similarity_max_length": {
        "description": "参与相似度匹配的文本最大长度",
        "type": "int",
        "default": 35
      },
      "type_frequency_thresholds": {
        "description": "消息类型发送频次阈值",
        "type": "object",
        "hint": "某类型组件仅在答案权重，或该答案内容作为问题出现的频次达到阈值时允许发送；0 表示不限制。",
        "items": {
          "Plain": {"description": "文本", "type": "int", "default": 0},
          "Image": {"description": "图片", "type": "int", "default": 0},
          "Face": {"description": "表情", "type": "int", "default": 0},
          "Record": {"description": "语音", "type": "int", "default": 0},
          "Video": {"description": "视频", "type": "int", "default": 0},
          "Json": {"description": "JSON 卡片", "type": "int", "default": 0},
          "File": {"description": "文件", "type": "int", "default": 0}
        }
      }
    }
  },
  "storage": {
    "description": "本地存储",
    "type": "object",
    "items": {
      "media_quota_gb": {
        "description": "媒体空间上限（GB）",
        "type": "float",
        "hint": "达到上限后停止保存新媒体，但继续文本学习，不自动删除有效旧媒体。",
        "default": 10.0
      }
    }
  },
  "webui": {
    "description": "管理页面",
    "type": "object",
    "hint": "管理页面使用 AstrBot Dashboard 的登录态和插件页面安全通道。独立登录服务将在完整 WebUI 阶段实现。",
    "items": {
      "enabled": {
        "description": "启用管理页面",
        "type": "bool",
        "default": true
      }
    }
  },
  "tts": {
    "description": "语音回复",
    "type": "object",
    "hint": "云端 TTS 可能产生费用，默认关闭；核心学习和回复算法不会调用 LLM。",
    "items": {
      "enabled": {
        "description": "启用 TTS",
        "type": "bool",
        "default": false
      },
      "driver": {
        "description": "TTS 驱动",
        "type": "string",
        "options": ["windows", "gpt_sovits", "local_http", "volcengine", "aliyun", "tencent", "azure", "openai", "openai_compatible", "custom_http"],
        "default": "windows"
      }
    }
  }
}
